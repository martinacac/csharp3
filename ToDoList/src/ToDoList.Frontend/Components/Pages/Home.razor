@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<br />

<b>@GetValue()</b>

<hr />

<p>Hodnota: @counter</p>

<button @onclick="IncrementCounter">Increment counter</button>
<hr />
<Dashboard />

@code
{
    private int counter = 1;

    private void IncrementCounter()
    {
        counter++;
    }

    private string GetValue()
    {
        return Guid.NewGuid().ToString();
    }

    public int Divide(int a, int b)
    {
        return a / b;
    }

    public int Multiply(int a, int b)
    {
        return a * b;
    }

    public void LogToConsole(string text)
    {
        Console.WriteLine(text);
    }

    public delegate int NumberOperationDelegate(int number1, int number2); //deklarace delegáta
    public delegate void StringTakingDelegate(string text);
    protected override void OnInitialized()
    {
        NumberOperationDelegate mujDelegat;
        mujDelegat = Multiply;
        mujDelegat += Multiply;
        mujDelegat += Divide; //předchozí výsledky zahodí a vrátí nulu (2/3 a int z toho) -> je lepší používat delegaty s void

        int result = mujDelegat(2, 3);
        Console.WriteLine(result);

        StringTakingDelegate mujDelegatNaString;
        mujDelegatNaString = LogToConsole;
        mujDelegatNaString?.Invoke("LogujuDoKonzole");

        List<string> strings = ["a", "b", "csafoskjapjd", "d", "e"];
        strings.Where(s => s.Contains('c'));
        strings.Where(DoesContainCharC);

        Action functionReturningVoid;
        Action<string> functionTakingStringAndReturningVoid;
        functionTakingStringAndReturningVoid = LogToConsole;

        functionTakingStringAndReturningVoid?.Invoke("Zprava z Action!");

        Func<bool> functionReturningBool;
        Func<int, int, int> functionReturningIntAndTakingTwoInts;

        functionReturningIntAndTakingTwoInts = Multiply;
    }

    public bool DoesContainCharC(string retezec)
    {
        return retezec.Contains('c');
    }

}
}