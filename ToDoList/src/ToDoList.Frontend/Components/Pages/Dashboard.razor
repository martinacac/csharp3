@using ToDoList.Domain.Models
@using ToDoList.Frontend.Models
@using ToDoList.Frontend.Clients
@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div>
    <button @onclick="OrderByID">Order by ID</button>
</div>
<div>
    <button @onclick="OrderByName">Order by Name</button>
</div>
<div>
    <h2>ToDo items dashboard</h2>

    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID<button class="btn btn-primary ml-3" @onclick="OrderByID">Order by ID ↓</button></th>
                <th>Název<button class="btn btn-primary ml-3" @onclick="OrderByName">Order by Name ↓</button></th>
                <th>Popis</th>
                <th>Kategorie<button class="btn btn-primary ml-3" @onclick="OrderByCategory">Order by Category
                        ↓</button></th>
                <th>Dokončeno</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr style="color:@(item.IsCompleted ? "green" : "black")">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Category</td>
                    <td>@(item.IsCompleted ? "Dokonceny" : "Nedokonceny")</td>
                    <td>
                        <button class="btn btn-success" @onclick="() => EditItem(item)">Editovat</button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)">Smazat</button>
                        <button class="btn btn-info" @onclick="() => ChangeCompleted(item)">Změnit dokončenost</button>

                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!string.IsNullOrEmpty(errorMessage) || !string.IsNullOrEmpty(errorMessage2))
    {
        <div class="alert alert-danger">
            <p>@errorMessage</p>
            @if (errorMessage.Contains("404"))
            {
                <p>Úkol nebyl nalezen v databázi.</p>
            }
            else if (errorMessage.Contains("500"))
            {
                <p>Došlo k chybě na serveru.</p>
            }
            <p>@errorMessage2</p>
        </div>
    }
    else
    {
        <div class="alert alert-success">OK</div>
    }
</div>

