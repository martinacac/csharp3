    public async Task ChangeCompleted(ToDoItemView toDoItem)
    {
        try
        {
            toDoItem.IsCompleted = !toDoItem.IsCompleted;
            var response = await toDoItemsClient.UpdateItemAsync(toDoItem);

            if (response.IsSuccessStatusCode)
            {
                // Update succeeded
                errorMessage = null;
            }
            else
            {
                // Reveal why it failed
                errorMessage = $"Update failed: {response.StatusCode} - {response.ReasonPhrase}";
                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    errorMessage2 = $"Update failed: {response.StatusCode} - {body}";
                }

            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Exception: {ex.Message}";
            errorMessage2 = $"Exception: {ex.Message}";
        }
    }

